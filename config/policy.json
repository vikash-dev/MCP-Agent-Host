{
  "policy_name": "Host Defense & Assessment Scope Policy",
  "version": "1.0.0",
  "scope": {
    "allowed_domains": [
      "example.com",
      "test.corp"
    ],
    "allowed_cidrs": [
      "10.0.0.0/8"
    ],
    "allowed_paths": [
      "./sample_data",
      "./runs"
    ]
  },
  "execution_limits": {
    "timeout_seconds": 25,
    "max_output_chars": 5000
  },
  "human_in_the_loop": {
    "default_requires_approval": false,
    "sensitive_tools": [
      "inspect_tls_cert"
    ]
  }
}